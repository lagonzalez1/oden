{# ── Node Definitions ─────────────────────────────────────── #}
NODES:
  (:Member)
      bioguide_id      : string  — unique Congress identifier (primary key)
      id               : string  — UUID
      first_name       : string
      last_name        : string
      full_name        : string  — may be null
      status           : string  — "Member" | "Spouse" | "Dependent" (filing status)
      state_district   : string  — e.g. "CA11"
      state            : string  — e.g. "CA"
      chamber          : string  — "house" | "senate" | "House" | "Senate"
      party            : string  — may be null
      leadership_role  : string  — may be null
      created_at       : datetime
      last_updated     : datetime — may be null
      updated_at       : datetime — may be null

  (:Committee)
      id               : string  — UUID (unique)
      committee_id     : string  — Thomas/code id e.g. "SSAF"
      title            : string  — committee name
      chamber          : string  — "house" | "senate" | "joint"
      is_subcommittee  : boolean
      parent_committee_id : string — may be null

  (:Asset)
      ticker           : string  — unique identifier e.g. "GOOGL"
      type             : string  — "ST" | "OP" | "OT"

  (:Issuer)
      name             : string  — legal entity name e.g. "Alphabet Inc Class A Common"

  (:Transaction)
      id               : string  — UUID
      doc_id           : string  — filing ID e.g. "20033725"
      type             : string  — "P" (Purchase) | "S" (Sale) | "E" (Exchange)
      trade_date       : date    — e.g. date("2026-01-16")
      amount_range     : string  — lower bound integer as string e.g. "500001"
      description      : string  — raw description text, may be null
      committee_relevance_score : float — 0.0–1.0 similarity to member committee jurisdiction, may be null
      matched_committee_id      : string — UUID of best-matched committee, may be null
      matched_committee_name    : string — may be null
      relevance_method          : string — e.g. "committee_chunk_embedding", may be null
      created_at       : datetime

  (:Derivative:CallOption)
      contract_id      : string  — "{ticker}-{strike}-{expiry}"
      strike_price     : float   — e.g. 150.0
      expiration_date  : date

{# ── Relationship Definitions ────────────────────────────── #}
RELATIONSHIPS:
  (Member)-[:IS_MEMBER_OF {role}]->(Committee)
      — legislator sits on this committee; role e.g. "Member" | "Chair"
  (Member)-[:EXECUTED]->(Transaction)
      — member performed this transaction
  (Transaction)-[:INVOLVES]->(Asset)
      — transaction is on this asset
  (Asset)-[:ISSUED_BY]->(Issuer)
      — asset belongs to this issuer
  (Transaction)-[:OF_DERIVATIVE]->(Derivative)
      — transaction is on a derivative contract
  (Derivative)-[:UNDERLYING_ASSET]->(Asset)
      — derivative is based on this asset

{# ── Query Rules ─────────────────────────────────────────── #}
STRICT RULES:
